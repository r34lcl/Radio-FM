# Copiar a .env y completar:  cp .env.example .env
# Generar claves aleatorias:   openssl rand -hex 24

# ---- Sintonía inicial (después se cambia desde la web, que tiene prioridad)
# Frecuencia en MHz de la primera emisora
FREQ=98.1
# Ganancia del dongle en dB, o "auto". Mejor elegirla con el escaneo de la banda (Configuración)
GAIN=auto
# 1 = estéreo, 0 = mono (mono suena mejor con señales débiles)
STEREO=1
# Bitrate del MP3 que se transmite
BITRATE=192k
# Índice del dongle si hay más de uno conectado
DEVICE_INDEX=0

# ---- Icecast (servidor de streaming interno)
ICECAST_SOURCE_PASSWORD=cambiar-esto
ICECAST_ADMIN_PASSWORD=cambiar-esto
ICECAST_MAX_CLIENTS=20
# Puerto de Icecast en el propio host (solo 127.0.0.1); los oyentes entran por la web
ICECAST_PORT=8010

# ---- Web (reproductor público en /, admin en /admin)
WEB_PORT=8080
WEB_USER=admin
WEB_PASSWORD=cambiar-esto
# Clave para firmar las sesiones (larga y aleatoria)
SESSION_SECRET=cambiar-esto
# true si la web se sirve por HTTPS (detrás de un proxy inverso con certificado)
COOKIE_SECURE=false
# true si la web está detrás de un proxy inverso (nginx, Caddy, Traefik, Nginx Proxy Manager…):
# así el registro de oyentes y el límite de intentos de login usan la IP real del cliente
TRUST_PROXY=false
# Días que se guarda el registro de oyentes
LISTENER_LOG_DAYS=90

# ---- Cloudflare Turnstile en el login (opcional; vacío = desactivado)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Reconocimiento de canciones (servicio songid)
# Segundos entre identificaciones de cada emisora con oyentes
SONGID_INTERVAL=45
